{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foxion37-gisul-mcp",
  "account_id": "8acc618e8c8c74a7713000006c396df8",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "GISUL_WATCH_REPO": "foxion37/portwright" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    { "binding": "SKILLS_BUCKET", "bucket_name": "foxion37-gisul-releases" }
  ]
}
